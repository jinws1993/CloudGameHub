# ============================================================
# CloudGameHub environment variables (EXAMPLE ONLY)
# ============================================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env to source control (already in .gitignore).

# HTTP port (left side of the docker-compose mapping)
NASGAME_PORT=14322

# Admin account created on first launch
NASGAME_ADMIN_USERNAME=admin
NASGAME_ADMIN_PASSWORD=admin123

# Timezone
TZ=Asia/Shanghai

# ---- AI / OpenAI-compatible API (optional but recommended) ----
# Set NASGAME_AI_ENABLED=true and provide a valid key to enable AI-powered
# game identification for messy ROM filenames.
NASGAME_AI_ENABLED=true
NASGAME_AI_BASE_URL=https://api.openai.com/v1
NASGAME_AI_API_KEY=sk-PUT-YOUR-KEY-HERE
NASGAME_AI_MODEL=gpt-4o-mini

# ---- ScreenScraper.fr (optional) ----
# Required if you want to scrape from ScreenScraper.fr instead of AI.
# Register at https://www.screenscraper.fr and request dev credentials.
# NASGAME_SCREENSCRAPER_USER=
# NASGAME_SCREENSCRAPER_PASS=
# NASGAME_SCREENSCRAPER_DEVID=
# NASGAME_SCREENSCRAPER_DEVPASS=

# ---- Outbound proxy (optional) ----
# Used by the scraper to reach ScreenScraper / AI API from networks that block them.
# NASGAME_PROXY_ENABLED=false
# NASGAME_PROXY_URL=http://192.168.31.144:1081

# ---- 115 Cloud Disk integration (optional) ----
# NASGAME_CLOUD_115_ENABLED=false
# NASGAME_CLOUD_115_COOKIE=